# Copy these settings into the shell environment before starting the app.
# This project does not automatically load .env files.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Optional: absolute path to a locally installed FlagEmbedding reranker.
RERANK_MODEL_PATH=
